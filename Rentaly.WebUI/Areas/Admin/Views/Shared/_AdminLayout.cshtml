@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var toastMessage = TempData["Success"] ?? TempData["Error"];
    var toastType = TempData["Success"] != null ? "success" : "error";
}

<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.PageTitle - RentCar Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/style.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    @if (toastMessage != null)
    {
        <div id="serverToast" data-message="@toastMessage" data-type="@toastType" hidden></div>
    }

    <aside class="sidebar" id="sidebar">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="sidebar-logo">
            <div class="logo-icon"><i class="fa-solid fa-car-side"></i></div>
            <div class="logo-text">
                <strong>RentCar</strong>
                <span>Admin Panel</span>
            </div>
        </a>

        <nav class="sidebar-nav" id="sidebarNav">
            <div class="menu-label">Ana Menü</div>
            <a asp-area="Admin" asp-controller="Home" asp-action="Index"
               class="nav-link @(currentController == "Home" ? "active" : "")">
                <span class="nav-icon"><i class="fa-solid fa-gauge-high"></i></span>
                <span class="link-text">Dashboard</span>
            </a>

            <div class="menu-label">Araç Yönetimi</div>
            <div class="has-submenu" id="vehicleMenu">
                <div class="nav-link" onclick="toggleSubmenu('vehicleSubmenu', 'vehicleMenu')">
                    <span class="nav-icon"><i class="fa-solid fa-cars"></i></span>
                    <span class="link-text">Araç Yönetimi</span>
                    <i class="fa-solid fa-chevron-right submenu-arrow ms-auto"></i>
                </div>
                <div class="submenu open" id="vehicleSubmenu">
                    <a href="#" class="nav-link">
                        <span class="nav-icon"><i class="fa-solid fa-list"></i></span>
                        <span class="link-text">Araç Listesi</span>
                    </a>
                    <a href="#" class="nav-link">
                        <span class="nav-icon"><i class="fa-solid fa-plus"></i></span>
                        <span class="link-text">Yeni Araç Ekle</span>
                    </a>
                    <a asp-area="Admin" asp-controller="Brand" asp-action="Index"
                       class="nav-link @(currentController == "Brand" ? "active" : "")">
                        <span class="nav-icon"><i class="fa-solid fa-trademark"></i></span>
                        <span class="link-text">Marka Yönetimi</span>
                    </a>
                    <a href="#" class="nav-link">
                        <span class="nav-icon"><i class="fa-solid fa-cube"></i></span>
                        <span class="link-text">Model Yönetimi</span>
                    </a>
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                       class="nav-link @(currentController == "Category" ? "active" : "")">
                        <span class="nav-icon"><i class="fa-solid fa-tags"></i></span>
                        <span class="link-text">Kategori Yönetimi</span>
                    </a>
                </div>
            </div>

            <div class="menu-label">Operasyon</div>
            <a asp-area="Admin" asp-controller="Branch" asp-action="Index"
               class="nav-link @(currentController == "Branch" ? "active" : "")">
                <span class="nav-icon"><i class="fa-solid fa-building"></i></span>
                <span class="link-text">Şube Yönetimi</span>
            </a>
            <a href="#" class="nav-link">
                <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
                <span class="link-text">Müşteri Yönetimi</span>
                <span class="menu-badge">12</span>
            </a>
            <a href="#" class="nav-link">
                <span class="nav-icon"><i class="fa-solid fa-calendar-check"></i></span>
                <span class="link-text">Rezervasyon Yönetimi</span>
                <span class="menu-badge">5</span>
            </a>
            <a href="#" class="nav-link">
                <span class="nav-icon"><i class="fa-solid fa-credit-card"></i></span>
                <span class="link-text">Ödeme Yönetimi</span>
            </a>

            <div class="menu-label">Sistem</div>
            <a href="#" class="nav-link">
                <span class="nav-icon"><i class="fa-solid fa-chart-line"></i></span>
                <span class="link-text">Raporlar</span>
            </a>
            <a href="#" class="nav-link">
                <span class="nav-icon"><i class="fa-solid fa-gear"></i></span>
                <span class="link-text">Ayarlar</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="user-avatar">A</div>
                <div class="user-info">
                    <div class="user-name">Admin User</div>
                    <div class="user-role">Süper Yönetici</div>
                </div>
            </div>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebarMobile()"></div>

    <div class="main-wrapper" id="mainWrapper">

        <nav class="navbar-top" id="navbarTop">
            <button class="toggle-btn" id="toggleBtn" onclick="toggleSidebar()">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="navbar-breadcrumb d-none d-sm-block">
                <ol class="breadcrumb">
                    <div class="navbar-breadcrumb d-none d-sm-block">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                            </li>
                            <li class="breadcrumb-item active">@ViewBag.PageTitle</li>
                        </ol>
                    </div>
                </ol>
            </div>
            <div class="navbar-actions ms-auto">
                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Siteyi Görüntüle
                </a>
            </div>
        </nav>

        <main class="page-content">
            @RenderBody()
        </main>

        <div class="modal fade" id="confirmDeleteModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Silme Onayı</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0"><span id="deleteItemName" class="fw-semibold"></span> kaydını silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                        <form id="confirmDeleteForm" method="post">
                            <button type="submit" class="btn btn-danger">Sil</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <footer class="site-footer">
            <div class="footer-text">© @DateTime.Now.Year <span>Rentaly</span> Yönetim Paneli</div>
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>