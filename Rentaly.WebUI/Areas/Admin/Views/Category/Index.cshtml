@model List<ResultCategoryDto>

@{
    ViewBag.PageTitle = "Kategori Yönetimi";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Kategoriler</h5>
        <a asp-action="CreateCategory" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Yeni Kategori
        </a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted mb-0">Henüz kategori eklenmemiş.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Kategori Adı</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CategoryName</td>
                            <td class="text-end">
                                <a asp-action="UpdateCategory" asp-route-id="@item.CategoryId"
                                   class="btn btn-sm btn-outline-primary">Düzenle</a>

                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmDeleteModal"
                                        data-delete-url="@Url.Action("DeleteCategory", "Category", new { area = "Admin", id = item.CategoryId })"
                                        data-item-name="@item.CategoryName">
                                    Sil
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>