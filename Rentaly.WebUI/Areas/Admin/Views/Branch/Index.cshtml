@model List<ResultBranchDto>

@{
    ViewBag.PageTitle = "Şube Yönetimi";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Şubeler</h5>
        <a asp-action="CreateBranch" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Yeni Şube
        </a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted mb-0">Henüz şube eklenmemiş.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Şube Adı</th>
                        <th>Şehir</th>
                        <th>Adres</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BranchName</td>
                            <td>@item.City</td>
                            <td class="text-muted">@item.Address</td>
                            <td class="text-end">
                                <a asp-action="UpdateBranch" asp-route-id="@item.BranchId"
                                   class="btn btn-sm btn-outline-primary">Düzenle</a>

                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmDeleteModal"
                                        data-delete-url="@Url.Action("DeleteBranch", "Branch", new { area = "Admin", id = item.BranchId })"
                                        data-item-name="@item.BranchName">
                                    Sil
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>