@model List<ResultBrandDto>
@{
    ViewBag.PageTitle = "Marka Yönetimi";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Markalar</h5>
        <a asp-action="CreateBrand" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Yeni Marka
        </a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted mb-0">Henüz marka eklenmemiş.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Görsel</th>
                        <th>Marka Adı</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><img src="@item.ImageUrl" alt="@item.BrandName" style="height:32px;" /></td>
                            <td>@item.BrandName</td>
                            <td class="text-end">
                                <a asp-action="UpdateBrand" asp-route-id="@item.BrandId"
                                   class="btn btn-sm btn-outline-primary">Düzenle</a>

                                <form asp-action="DeleteBrand" asp-route-id="@item.BrandId"
                                      method="post" class="d-inline">
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#confirmDeleteModal"
                                            data-delete-url="@Url.Action("DeleteBrand", "Brand", new { area = "Admin", id = item.BrandId })"
                                            data-item-name="@item.BrandName">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>