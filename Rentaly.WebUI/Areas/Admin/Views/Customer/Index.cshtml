@model List<ResultCustomerDto>
@{
    ViewBag.PageTitle = "Müşteri Yönetimi";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Müşteriler</h5>
        <span class="text-muted small">@Model.Count kayıt</span>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted mb-0">Henüz müşteri kaydı yok. Kayıtlar rezervasyon formundan oluşur.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.Name @item.Surname</td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td class="text-end">
                                <a asp-action="UpdateCustomer" asp-route-id="@item.CustomerId"
                                   class="btn btn-sm btn-outline-primary">Düzenle</a>

                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmDeleteModal"
                                        data-delete-url="@Url.Action("DeleteCustomer", "Customer", new { area = "Admin", id = item.CustomerId })"
                                        data-item-name="@item.Name @item.Surname">
                                    Sil
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>