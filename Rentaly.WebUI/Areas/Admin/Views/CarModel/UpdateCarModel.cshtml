@model UpdateCarModelDto
@{
    ViewBag.PageTitle = "Model Düzenle";
}

<div class="card p-4">
    <h5 class="mb-4">Model Düzenle</h5>

    <form asp-action="UpdateCarModel" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <input type="hidden" asp-for="CarModelId" />

        <div class="mb-3">
            <label asp-for="BrandId" class="form-label">Marka</label>
            <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                <option value="">Marka seçiniz</option>
            </select>
            <span asp-validation-for="BrandId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ModelName" class="form-label">Model Adı</label>
            <input asp-for="ModelName" class="form-control" />
            <span asp-validation-for="ModelName" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </div>
    </form>
</div>