@model List<ResultCarModelDto>
@{
    ViewBag.PageTitle = "Model Yönetimi";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Modeller</h5>
        <a asp-action="CreateCarModel" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Yeni Model
        </a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted mb-0">Henüz model eklenmemiş.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Model Adı</th>
                        <th>Marka</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ModelName</td>
                            <td><span class="badge text-bg-secondary">@item.BrandName</span></td>
                            <td class="text-end">
                                <a asp-action="UpdateCarModel" asp-route-id="@item.CarModelId"
                                   class="btn btn-sm btn-outline-primary">Düzenle</a>

                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmDeleteModal"
                                        data-delete-url="@Url.Action("DeleteCarModel", "CarModel", new { area = "Admin", id = item.CarModelId })"
                                        data-item-name="@item.BrandName @item.ModelName">
                                    Sil
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>